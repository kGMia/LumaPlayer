    "Deinterlace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去交錯"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去交錯"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
