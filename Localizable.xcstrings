    },
    "Use an HTTP(S) or RTSP URL. Enter credentials in the separate fields, not in the URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用HTTP(S)或RTSP網址，並在獨立欄位中輸入憑證，請勿直接寫入網址中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用HTTP(S)或RTSP網址，並在獨立欄位中輸入憑證，請勿直接寫入網址中。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用HTTP(S)或RTSP網址，並在獨立欄位中輸入憑證，請勿直接寫入網址中。"
