    "CPU samples this process once per second; 100% equals one CPU core. Memory is this process, not system usage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU用量每秒取樣一次，以此行程為範圍；100%相當於使用一個CPU核心。記憶體數值表示此行程的用量，而非整個系統的用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU用量每秒取樣一次，以此行程為範圍；100%相當於使用一個CPU核心。記憶體數值表示此行程的用量，而非整個系統的用量。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU用量每秒取樣一次，以此行程為範圍；100%相當於使用一個CPU核心。記憶體數值表示此行程的用量，而非整個系統的用量。"
          }
        },
        "zh-Hant-TW": {
